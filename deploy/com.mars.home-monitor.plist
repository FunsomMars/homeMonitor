<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mars.home-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>server</string>
    <string>--port</string>
    <string>8787</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--config</string>
    <string>/Users/mars/homeMonitor/config/devices.json</string>
    <string>--db</string>
    <string>/Users/mars/homeMonitor/data/telemetry.db</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/mars/homeMonitor</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/mars/homeMonitor/data/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mars/homeMonitor/data/launchd.stderr.log</string>
</dict>
</plist>
